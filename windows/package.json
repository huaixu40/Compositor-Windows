{
  "name": "compositor-windows",
  "version": "0.5.0",
  "description": "Unofficial Windows adaptation of Compositor with layered PSD editing",
  "private": true,
  "main": "main.cjs",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "npm run build && electron . --self-test",
    "package": "npm run build && node scripts/package.cjs",
    "test:interaction": "npm run build && node test/interactions.cjs",
    "test:render": "npm run build && node test/render-project.cjs",
    "test:semantic": "npm run build && node test/semantic.cjs",
    "test:performance": "npm run build && node test/benchmark.cjs"
  },
  "dependencies": {
    "ag-psd": "31.0.3",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "esbuild": "0.25.12",
    "playwright": "1.62.1"
  }
}
